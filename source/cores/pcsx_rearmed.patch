diff --git a/libpcsxcore/gte.c b/libpcsxcore/gte.c
index 357eb16..6f1c2ea 100644
--- a/libpcsxcore/gte.c
+++ b/libpcsxcore/gte.c
@@ -565,6 +565,13 @@ static u32 gteMAC123f(psxCP2Regs *regs, s32 vx, s32 vy, s32 vz,
 
 #endif
 
+/* widescreen la nivel GTE (ca "Widescreen Hack" din DuckStation): X proiectat * 3/4 fata de centru */
+#ifndef FLAGLESS
+int gte_widescreen = 0;
+#else
+extern int gte_widescreen;
+#endif
+#define WSX(p) (gte_widescreen ? (((p) * 3) >> 2) : (p))
 static inline force_inline void gteRTPS(psxCP2Regs *regs, int shift, int lm)
 {
 	s32 vx = gteVX0, vy = gteVY0, vz = gteVZ0;
@@ -592,7 +599,7 @@ static inline force_inline void gteRTPS(psxCP2Regs *regs, int shift, int lm)
 	gteSXY0 = gteSXY1;
 	gteSXY1 = gteSXY2;
 
-	gteSX2 = limG1(&flags, mac0flags(&flags, gteOFX + (s64)gteIR1 * quotient) >> 16);
+	gteSX2 = limG1(&flags, mac0flags(&flags, gteOFX + WSX((s64)gteIR1 * quotient)) >> 16);
 	gteSY2 = limG2(&flags, mac0flags(&flags, gteOFY + (s64)gteIR2 * quotient) >> 16);
 
 	gteMAC0 = mac0 = mac0flags(&flags, gteDQB + (s64)gteDQA * quotient);
@@ -628,7 +635,7 @@ static inline force_inline void gteRTPT(psxCP2Regs *regs, int shift, int lm)
 		sz3 = limD(&flags, sz3);
 		quotient = divide(&flags, h, sz3);
 		fSZ(v) = sz3;
-		fSX(v) = limG1(&flags, mac0flags(&flags, gteOFX + (s64)ir1 * quotient) >> 16);
+		fSX(v) = limG1(&flags, mac0flags(&flags, gteOFX + WSX((s64)ir1 * quotient)) >> 16);
 		fSY(v) = limG2(&flags, mac0flags(&flags, gteOFY + (s64)ir2 * quotient) >> 16);
 	}
 
